# ===== Public Marketing & SEO =====
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ===== Lead Delivery Providers =====
# Webhook for all lead submissions (contact + waitlist fallback)
LEADS_WEBHOOK_URL=
# Optional dedicated webhook for waiting list submissions
WAITLIST_WEBHOOK_URL=

# ===== Email SMTP (custom) =====
MAIL_FROM=hello@getmarveo.com
MAIL_SENDER_NAME=Marveo
MAIL_PROVIDER=mail.getmarveo.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=hello@getmarveo.com
MAIL_PASSWORD=your-smtp-password

# ===== Lead Routing =====
LEADS_ALERT_EMAIL=hello@getmarveo.com
SALES_ALERT_EMAIL=sales@getmarveo.com
PARTNERS_ALERT_EMAIL=partners@getmarveo.com

# ===== Resend fallback (optional, not used) =====
RESEND_API_KEY=
LEADS_FROM_EMAIL=Marveo Leads <onboarding@getmarveo.com>
